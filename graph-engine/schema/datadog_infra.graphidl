// A synthetic, Datadog-shaped infrastructure graph: the kind of topology
// the Infrastructure List, Service Catalog and APM service map surface
// today as separate UIs over what is really one inventory. `CloudAccount`
// down to `Container` is the ownership hierarchy; `Service` is the layer
// everything else (dependencies, ownership, monitoring, dashboards)
// attaches to — the same "one inventory, several lenses" shape as
// `cloud_cost.graphidl`, just for observability data instead of billing.
//
// Generated by `examples/datadog-dataset/generate_dataset.py` (~1000
// nodes). That script writes CSV, not Iceberg tables — adapt it to the
// `edge_schema_with`/`write_table` pattern in
// `examples/ingest-cloud-cost/src/main.rs` if this needs to be loaded
// into a running `graph-partition-node`.

schema graph_v1 {
  node CloudAccount {
    id: NodeId
    @indexed account_id: String
    provider: String        // aws | gcp | azure
    name: String
  }

  node Team {
    id: NodeId
    @indexed name: String
    slack_channel: String
  }

  // The layer every other label attaches to — same role `Resource` plays
  // in `cloud_cost.graphidl`.
  node Service {
    id: NodeId
    @indexed name: String
    @indexed env: String          // prod | staging | dev
    language: String
    @indexed tier: Int64          // 1 (critical) .. 4 (low)
    version: String
  }

  node Host {
    id: NodeId
    @indexed hostname: String
    instance_type: String
    region: String
    az: String
    os: String
  }

  // The largest label by far — containers outnumber hosts the way they
  // do in a real fleet, not a flat 1:1 split.
  node Container {
    id: NodeId
    @indexed name: String
    image: String
    cpu_limit_m: Int64        // millicores
    memory_limit_mb: Int64
  }

  node Monitor {
    id: NodeId
    @indexed name: String
    @indexed monitor_type: String   // metric alert | apm | log | synthetic | process
    @indexed status: String         // OK | Alert | Warn | No Data
    priority: String                // P1..P5
  }

  node Dashboard {
    id: NodeId
    @indexed name: String
    dashboard_type: String    // timeboard | screenboard
  }

  edge CONTAINS {
    from: CloudAccount
    to: Host
  }

  edge OWNS {
    from: Team
    to: Service
  }

  edge RUNS_ON {
    from: Container
    to: Host
  }

  edge PART_OF {
    from: Container
    to: Service
  }

  edge MONITORS {
    from: Monitor
    to: Service
  }

  // Service dependency map (what APM's service map infers from traces).
  // Not necessarily acyclic — real service graphs have cycles (A calls B
  // calls A through a callback/webhook), so the generator doesn't filter
  // them out.
  edge DEPENDS_ON {
    from: Service
    to: Service
  }

  edge DISPLAYS {
    from: Dashboard
    to: Service
  }
}
